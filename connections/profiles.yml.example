# Example Recon connection profiles.
# Copy this file to connections/profiles.yml for local use.
# Do not commit real profiles or secrets.

profiles:
  local:
    target: dev
    outputs:
      dev:
        connections:
          legacy:
            type: duckdb
            database: "{{ env_var('RECON_DUCKDB_PATH') }}"
          warehouse:
            type: duckdb
            database: "{{ env_var('RECON_DUCKDB_PATH') }}"

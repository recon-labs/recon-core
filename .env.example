# Recon Core local development environment example
# Copy this file to .env for local use.
# Do not commit real secrets.

# Python / tooling
PYTHONUNBUFFERED=1

# Recon project defaults
RECON_PROFILE=dev
RECON_TARGET_PATH=target
RECON_REPORT_PATH=reports
RECON_STATE_PATH=state

# Example source connection placeholders
SOURCE_HOST=localhost
SOURCE_PORT=5432
SOURCE_DATABASE=source_db
SOURCE_USER=recon_user
SOURCE_PASSWORD=change_me

# Example target connection placeholders
TARGET_HOST=localhost
TARGET_PORT=5432
TARGET_DATABASE=target_db
TARGET_USER=recon_user
TARGET_PASSWORD=change_me

# Example warehouse placeholders
SNOWFLAKE_ACCOUNT=example_account
SNOWFLAKE_USER=example_user
SNOWFLAKE_PASSWORD=change_me
SNOWFLAKE_ROLE=example_role
SNOWFLAKE_WAREHOUSE=example_warehouse
SNOWFLAKE_DATABASE=example_database
SNOWFLAKE_SCHEMA=example_schema

# Example BigQuery placeholder
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
